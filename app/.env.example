# Copy this file to .env.local (which Git ignores) to turn on sync while developing.
# Both values are in the Supabase dashboard: Project Settings → API.
# The anon (publishable) key is meant to be public; row-level security protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
